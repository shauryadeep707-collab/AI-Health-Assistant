# === AI Health Assistant Configuration ===
# Copy this file to .env and fill in your values

# Flask secret key (auto-generated by setup_wizard.py)
SECRET_KEY=change-me-to-a-random-string

# AI Mode: 'openai' for real AI, 'demo' for rule-based fallback
# If key is missing or API fails, demo mode is used automatically
AI_MODE=demo

# OpenAI API (optional - demo mode works without it)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# Database: leave empty for SQLite (local), or set for PostgreSQL (cloud)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=

# Oracle Database (optional - only if your college requires Oracle)
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=
ORACLE_WALLET_DIR=

# Google Maps API key (optional - Leaflet/OpenStreetMap works without it)
GOOGLE_MAPS_API_KEY=

# Emergency numbers (India defaults)
EMERGENCY_NUMBER=112
AMBULANCE_NUMBER=108

# AI rate limit per user per day
AI_DAILY_LIMIT=30

# Google Drive backup (optional)
GOOGLE_DRIVE_CREDENTIALS_PATH=
GOOGLE_DRIVE_FOLDER_ID=
